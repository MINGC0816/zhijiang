# 内网 vLLM（需先连 VPN）
VLLM_BASE_URL=http://10.60.40.130:12333/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen3.5-VL-122B

# Qwen3：关闭强思考（服务端也可设 default-chat-template-kwargs）
VLLM_ENABLE_THINKING=false

# 本地 Embedding（相对项目根目录；默认使用 models/bge-small-zh-v1.5）
# 也可写绝对路径。若目录不存在，才会把该值当作 HuggingFace repo id。
EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5

# 检索与分块
RETRIEVE_TOP_K=4
RETRIEVE_CANDIDATE_K=20
RETRIEVE_MODE=hybrid_rerank
RRF_K=60
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# 本地 Reranker（可选；不存在时自动降级为 BM25+向量）
# python scripts/download_reranker.py
RERANKER_MODEL_PATH=models/bge-reranker-base

# 可选：向量库集合名
# CHROMA_COLLECTION=enterprise_kb

# 运行日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 统一身份认证（生产环境务必修改 JWT_SECRET 与 DEFAULT_ADMIN_PASSWORD）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24
JWT_KB_ADMIN_EXPIRE_MINUTES=120
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Langfuse 可观测性（可选）。不填则只写 data/traces/last.json
# 失败样例：python scripts/demo_fail_trace.py
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
